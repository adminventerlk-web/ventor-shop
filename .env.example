# VenterShop Environment Configuration Guide for Deployment

# 1. MongoDB Connection String (Atlas or Hosted Mongo Instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ventershop?retryWrites=true&w=majority

# 2. Authentication Secret (JWT key, must be at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# 3. Base Application Public URL
NEXT_PUBLIC_APP_URL=https://ventershop.vercel.app

# 4. Cloudinary Storage API Credentials (For Image Uploads & Product Media)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. Email Service Credentials (SMTP Transporter for OTP & Order Receipts)
# Note: If left blank or "placeholder", VenterShop automatically uses Ethereal test mail mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_store_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM="VENTERSHOP" <noreply@ventershop.com>
